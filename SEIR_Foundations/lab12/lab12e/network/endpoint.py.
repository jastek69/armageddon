#
# ============================================================================
# DO NOT SOLVE PATH SELECTION IN endpoint.py
# ============================================================================
#
# Preserve.
#
#
# ============================================================================
# FUTURE QUESTION — ENDPOINT NORMALIZATION
# ============================================================================
#
# Different providers represent endpoints differently:
#
#
#       hostname
#
#       URI
#
#       resource ID
#
#       IP
#
#       service name
#
#
# A future normalized endpoint contract may help.
#
#
# But normalization should preserve the information actually required by
# behavior.
#
#
# ============================================================================
# NORMALIZATION != INFORMATION DESTRUCTION
# ============================================================================
#
